{
  "name": "@appliqation/pr-raise",
  "version": "0.1.3",
  "description": "Standalone agent that commits local file changes in a repo checkout and opens (or reuses) a pull request. Fully mechanical — no LLM involved — reusable for scripts from appliqation-scriptgen or code changes from any future defect-fix agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appliqation/pr-raise.git"
  },
  "homepage": "https://github.com/appliqation/pr-raise#readme",
  "bugs": {
    "url": "https://github.com/appliqation/pr-raise/issues"
  },
  "type": "module",
  "bin": {
    "appliqation-pr-raise": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@appliqation/agent-core": "^0.1.5",
    "@octokit/rest": "^21.1.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.10",
    "eslint": "^9.39.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
