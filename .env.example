# appq connection — only used to call get_project_settings (repo_url,
# branch, tests_dir). appq never returns a GitHub credential to this agent.
APPQ_ORIGIN=https://appq.appliqation.io
APPQ_API_KEY=

# This agent's OWN GitHub token — deliberately separate from appq's
# per-project encrypted PAT store, which this client never reads. Needs
# repo write access (contents + pull-requests) on whatever repos you point
# --project-id at.
GITHUB_TOKEN=

# Commit author identity for whatever this agent commits.
GIT_AUTHOR_NAME=Appliqation PR Agent
GIT_AUTHOR_EMAIL=noreply@appliqation.io

# Wall-clock cap per individual git/GitHub call.
COMMAND_TIMEOUT_MS=120000

# Audit logging — entirely opt-in, nothing is recorded anywhere unless one of
# these is set. Precedence: Mongo (if fully configured) > JSONL > none. This
# is a parallel system's own audit trail, deliberately not part of appq —
# see @appliqation/agent-core's audit/sink.ts. AUDIT_MONGO_DB/_COLLECTION
# are required together with AUDIT_MONGO_URI — no default collection name.
AUDIT_MONGO_URI=
AUDIT_MONGO_DB=
AUDIT_MONGO_COLLECTION=
AUDIT_JSONL_PATH=
